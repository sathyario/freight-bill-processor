# PostgreSQL (local docker)
DATABASE_URL=postgresql://freight:localpass@postgres:5432/freightdb

# Neo4j (local docker)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpass

# LLM — Gemini (free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith tracing (free tier: https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=freight-bill-processor

# App
SEED_DATA_PATH=/app/seed_data.json
LOG_LEVEL=INFO
